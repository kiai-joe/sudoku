                android:fontFamily="@font/inter_bold"
                android:textColor="@color/widget_ink_muted"
                android:textSize="11sp"
                tools:text="M" />

            <FrameLayout
                android:id="@+id/widget_day5"
                android:layout_width="30dp"
                android:layout_height="30dp"
