                android:background="@drawable/widget_day_other">

                <TextView
                    android:id="@+id/widget_number5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sora_medium"
                    android:gravity="center"
