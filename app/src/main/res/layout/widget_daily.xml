        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_letter6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/widget_ink_muted"
                android:textSize="10sp"
                tools:text="M" />

            <FrameLayout
                android:id="@+id/widget_day6"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_other">

                <TextView
                    android:id="@+id/widget_number6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sora_medium"
                    android:gravity="center"
                    android:textColor="@color/widget_ink_muted"
                    android:textSize="12sp"
                    tools:text="8" />

                <ImageView
                    android:id="@+id/widget_check6"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_check"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
