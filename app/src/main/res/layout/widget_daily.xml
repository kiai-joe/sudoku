<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: today's daily puzzle, the streak and this week,
     in two rows so it fits a 4x2 cell (about 130dp tall). Filled in by SumiWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textColor="@color/widget_ink_muted"
                android:textSize="10sp"
                tools:text="DAILY · THURSDAY 5 NOVEMBER" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/sora_semibold"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="19sp"
                    tools:text="Medium" />

                <LinearLayout
                    android:id="@+id/widget_streak_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/widget_pill_shu_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="9dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_flame" />

                    <TextView
                        android:id="@+id/widget_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/widget_shu"
                        android:textSize="12sp"
                        tools:text="5" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_action"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_pill_ai"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/widget_action_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_play" />

            <TextView
                android:id="@+id/widget_action_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:maxLines="1"
                android:textColor="@color/widget_on_ai"
                android:textSize="14sp"
                tools:text="Play" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_letter0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/widget_ink_muted"
                android:textSize="10sp"
                tools:text="M" />

            <FrameLayout
                android:id="@+id/widget_day0"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_other">

                <TextView
                    android:id="@+id/widget_number0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sora_medium"
                    android:gravity="center"
                    android:textColor="@color/widget_ink_muted"
                    android:textSize="12sp"
                    tools:text="2" />

                <ImageView
                    android:id="@+id/widget_check0"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_check"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_letter1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/widget_ink_muted"
                android:textSize="10sp"
                tools:text="M" />

            <FrameLayout
                android:id="@+id/widget_day1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_other">

                <TextView
                    android:id="@+id/widget_number1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sora_medium"
                    android:gravity="center"
                    android:textColor="@color/widget_ink_muted"
                    android:textSize="12sp"
                    tools:text="3" />

                <ImageView
                    android:id="@+id/widget_check1"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_check"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_letter2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
