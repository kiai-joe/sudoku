<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same file in Google backup and in
     phone-to-phone transfer when setting up a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="sudoku.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="sudoku.xml" />
    </device-transfer>
</data-extraction-rules>
